# =============================================================================
# PDFly — AI Engine Environment Variables
# =============================================================================

# AI Provider: Google Gemini API
# PDFly connects to Google Gemini with automatic model fallbacks and exponential backoff retry.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to gemini-2.0-flash)
# Available models: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# Newsletter & Email Capture (Vercel Serverless Persistence)
# =============================================================================

# Configurable Webhook URL for capturing newsletter subscriber emails.
# On Vercel, the local filesystem is read-only and ephemeral, so emails are
# dispatched via HTTP POST to a persistent webhook service.
#
# Free services that work out of the box with zero code changes:
# 1. Formspree (Free tier: 50 submissions/month): https://formspree.io
#    Format: https://formspree.io/f/your_form_id
# 2. Google Sheets via Google Apps Script (100% free, unlimited rows in your spreadsheet):
#    Format: https://script.google.com/macros/s/your_deployment_id/exec
# 3. Zapier / Make / Webhook endpoints / Discord or Slack webhooks
SUBSCRIBE_WEBHOOK_URL=https://formspree.io/f/your_form_id

