# =============================================================================
# PDFly — AI Engine Environment Variables
# =============================================================================

# AI Provider: Google Gemini API
# PDFly connects to Google Gemini with automatic model fallbacks and exponential backoff retry.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to gemini-3.5-flash)
# Available models: gemini-3.5-flash, gemini-flash-lite-latest, gemini-3.5-flash-lite, gemini-3.6-flash, gemini-flash-latest, gemini-3.7-flash, gemini-pro-latest
GEMINI_MODEL=gemini-3.5-flash
