# =============================================================================
# PDFly — AI Engine Environment Variables
# =============================================================================

# Primary AI Provider: Google Gemini API (Recommended)
# PDFly connects to Google Gemini with automatic model fallbacks and exponential backoff retry.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (Defaults to gemini-flash-latest)
# Available models: gemini-flash-latest, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-pro-latest
GEMINI_MODEL=gemini-flash-latest

# Fallback / Alternative AI Provider: Anthropic Claude API
# Used automatically if GEMINI_API_KEY is not configured or left empty.
# Obtain an API key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Preferred Anthropic Model (Defaults to claude-sonnet-4-6)
# Available models: claude-sonnet-4-6, claude-3-5-sonnet-20241022
ANTHROPIC_MODEL=claude-sonnet-4-6
